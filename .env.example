JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_URL=

# Midtrans payment gateway (backend/routes/midtrans.js). Get real values from
# the Midtrans Dashboard (Settings > Access Keys) - use the SB-Mid-* sandbox
# keys while testing, and the production keys (with MIDTRANS_IS_PRODUCTION=true)
# only once genuinely ready to take real payments.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# 'true' to hit Midtrans's production API, anything else (including unset)
# stays on sandbox.
MIDTRANS_IS_PRODUCTION=false

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=
# Public Midtrans Snap.js client key (frontend-user/index.html substitutes
# this into the %VITE_MIDTRANS_CLIENT_KEY% placeholder at build time). Must
# match the client key half of MIDTRANS_CLIENT_KEY above. Safe to expose
# client-side - it is not a secret, unlike the server key.
VITE_MIDTRANS_CLIENT_KEY=

# Backend CORS (backend/server.js). Wira's own Vercel URLs, their preview
# deploys, the Capacitor apps and local dev ports are already allowed; list
# any extra browser origins here, comma-separated and exact
# (e.g. https://app.wira.id,https://admin.wira.id) - e.g. a custom domain.
CORS_EXTRA_ORIGINS=

# Backend: where Midtrans sends the customer after payment (default https://wira-pied.vercel.app)
FRONTEND_USER_URL=
