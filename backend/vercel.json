{
  "version": 2,
  "ignoreCommand": "bash ../scripts/vercel-ignore-build.sh",
  "git": { "deploymentEnabled": { "claude/**": false } },
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
