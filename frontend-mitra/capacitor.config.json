{
  "appId": "com.wira.mitra",
  "appName": "Wira Mitra",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_wira",
      "iconColor": "#B7862A"
    },
    "SplashScreen": {
      "backgroundColor": "#B7862A"
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "updateUrl": "",
      "statsUrl": "",
      "channelUrl": "",
      "appReadyTimeout": 15000,
      "resetWhenUpdate": true
    }
  }
}
