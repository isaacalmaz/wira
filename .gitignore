# Node dependencies
node_modules/
*/node_modules/

# Build outputs
dist/
*/dist/

# Environment files - any .env.* variant, anywhere in the tree, except the
# checked-in .env.example template. Broadened after backend/.env.firebase (a
# real Firebase Admin service-account private key) was committed to this
# public repo on 2026-09-17 - the old patterns below only matched .env.local
# and .env.*.local, not a plain .env.firebase.
.env
.env.local
.env.*.local
.env.firebase
*/.env
*/.env.local
*/.env.firebase
**/.env.*
!**/.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories
.vscode/
.idea/

# Android build tool downloads
*/android/gradle.zip
*/android/jdk*.tar.gz
*/android/.gradle/
*/android/app/build/
*/android/build/
*/android/capacitor-cordova-android-plugins/build/

# Agent run scratch logs
.agents/explorer_*/
.agents/orchestrator_*/
.agents/spec_miner_*/
.agents/test_writer_*/
